{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HEPS Mechanical Era Draw Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draw_id",
    "draw_date",
    "main_numbers",
    "powerball",
    "macro_sum",
    "regime",
    "machine_name",
    "source_url",
    "data_quality_flags"
  ],
  "properties": {
    "draw_id": { "type": "integer", "minimum": 1 },
    "draw_date": { "type": "string", "format": "date" },
    "main_numbers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 50 }
    },
    "powerball": { "type": "integer", "minimum": 1, "maximum": 16 },
    "macro_sum": { "type": "integer", "minimum": 15, "maximum": 240 },
    "regime": { "const": "mechanical_50_16" },
    "machine_name": { "type": "string", "minLength": 1, "default": "unknown" },
    "source_url": { "type": ["string", "null"] },
    "data_quality_flags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "notes": { "type": ["string", "null"] }
  }
}
