{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HEPS-Evolve v0.1 Candidate-Ranking Genome",
  "type": "object",
  "required": ["features"],
  "properties": {
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["kind", "weight", "params"],
        "properties": {
          "kind": {
            "enum": ["recency", "frequency", "gap_target", "shadow", "residue", "transition"]
          },
          "weight": {"type": "number", "minimum": -2.5, "maximum": 2.5},
          "params": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
